    <AssemblyName>YuzuPresence</AssemblyName>
    <RootNamespace>YuzuPresence</RootNamespace>
    <UseWPF>true</UseWPF>
    <LangVersion>9.0</LangVersion>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
